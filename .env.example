# MySQL connection. Railway MySQL variables can be mapped to these names.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Generate a cryptographically random secret of at least 32 characters.
JWT_SECRET=

# Browser origin only: do not include /Password_Manager/ here.
FRONTEND_ORIGIN=https://tanshi2003.github.io

# Full frontend URL used to build password-reset links.
FRONTEND_URL=https://tanshi2003.github.io/Password_Manager/

# SMTP account used only for account-password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
