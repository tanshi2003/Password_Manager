# TiDB Cloud Starter (MySQL-compatible)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=password_manager
TIDB_SSL=true

# Generate a random secret of at least 32 bytes. Keep it only in Render env vars.
JWT_SECRET=

# GitHub Pages frontend origin and full URL
FRONTEND_ORIGIN=https://tanshi2003.github.io
FRONTEND_URL=https://tanshi2003.github.io/Password_Manager/

# Optional account-password reset email via Resend HTTPS API.
# Requires a sender address/domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMTP fallback for local/self-hosted deployments only.
# Render Free blocks SMTP ports 25, 465 and 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
